DEFINE SCHEMA

    RECORD TYPE CD_AIQuestion (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_answer" STRING,
        "CD_answer_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_drawingData" BYTES,
        "CD_drawingData_ckAsset" ASSET,
        "CD_entityName" STRING,
        "CD_helpful" INT64,
        "CD_id" STRING,
        "CD_imageData" BYTES,
        "CD_imageData_ckAsset" ASSET,
        "CD_question" STRING,
        "CD_question_ckAsset" ASSET,
        "CD_subject" STRING,
        "CD_subject_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ExamPlan (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_createdAt" TIMESTAMP,
        "CD_entityName" STRING,
        "CD_examDate" TIMESTAMP,
        "CD_id" STRING,
        "CD_modeRaw" STRING,
        "CD_modeRaw_ckAsset" ASSET,
        "CD_name" STRING,
        "CD_name_ckAsset" ASSET,
        "CD_unitsData" BYTES,
        "CD_unitsData_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MathNote (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_analysisData" BYTES,
        "CD_analysisData_ckAsset" ASSET,
        "CD_annotationsData" BYTES,
        "CD_annotationsData_ckAsset" ASSET,
        "CD_conceptKey" STRING,
        "CD_conceptKey_ckAsset" ASSET,
        "CD_correctAnswer" STRING,
        "CD_correctAnswer_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_drawingData" BYTES,
        "CD_drawingData_ckAsset" ASSET,
        "CD_entityName" STRING,
        "CD_gradeData" BYTES,
        "CD_gradeData_ckAsset" ASSET,
        "CD_guidedSolveData" BYTES,
        "CD_guidedSolveData_ckAsset" ASSET,
        "CD_id" STRING,
        "CD_imageData" BYTES,
        "CD_imageData_ckAsset" ASSET,
        "CD_kindRaw" STRING,
        "CD_kindRaw_ckAsset" ASSET,
        "CD_ladderData" BYTES,
        "CD_ladderData_ckAsset" ASSET,
        "CD_myAnswer" STRING,
        "CD_myAnswer_ckAsset" ASSET,
        "CD_problemImageData" BYTES,
        "CD_problemImageData_ckAsset" ASSET,
        "CD_recognitionRaw" STRING,
        "CD_recognitionRaw_ckAsset" ASSET,
        "CD_recognizedText" STRING,
        "CD_recognizedText_ckAsset" ASSET,
        "CD_scanData" BYTES,
        "CD_scanData_ckAsset" ASSET,
        "CD_solutionData" BYTES,
        "CD_solutionData_ckAsset" ASSET,
        "CD_statusRaw" STRING,
        "CD_statusRaw_ckAsset" ASSET,
        "CD_stepAnswersData" BYTES,
        "CD_stepAnswersData_ckAsset" ASSET,
        "CD_subject" STRING,
        "CD_subject_ckAsset" ASSET,
        "CD_thumbnailData" BYTES,
        "CD_thumbnailData_ckAsset" ASSET,
        "CD_title" STRING,
        "CD_title_ckAsset" ASSET,
        "CD_unit" STRING,
        "CD_unit_ckAsset" ASSET,
        "CD_updatedAt" TIMESTAMP,
        "CD_workCheckData" BYTES,
        "CD_workCheckData_ckAsset" ASSET,
        "CD_workText" STRING,
        "CD_workText_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Memo (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_colorHex" STRING,
        "CD_colorHex_ckAsset" ASSET,
        "CD_content" STRING,
        "CD_content_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_entityName" STRING,
        "CD_id" STRING,
        "CD_isPinned" INT64,
        "CD_title" STRING,
        "CD_title_ckAsset" ASSET,
        "CD_updatedAt" TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Plan (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_category" STRING,
        "CD_completedKeys" BYTES,
        "CD_completedKeys_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_durationMinutes" INT64,
        "CD_entityName" STRING,
        "CD_id" STRING,
        "CD_isAllDay" INT64,
        "CD_kindRaw" STRING,
        "CD_kindRaw_ckAsset" ASSET,
        "CD_lockApps" INT64,
        "CD_note" STRING,
        "CD_note_ckAsset" ASSET,
        "CD_reminderMinutes" INT64,
        "CD_repeatEnd" TIMESTAMP,
        "CD_repeatRaw" STRING,
        "CD_repeatRaw_ckAsset" ASSET,
        "CD_startDate" TIMESTAMP,
        "CD_title" STRING,
        "CD_title_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PlanCategory (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_colorHex" STRING,
        "CD_colorHex_ckAsset" ASSET,
        "CD_entityName" STRING,
        "CD_id" STRING,
        "CD_isStudy" INT64,
        "CD_name" STRING,
        "CD_name_ckAsset" ASSET,
        "CD_sortIndex" INT64,
        "CD_symbol" STRING,
        "CD_symbol_ckAsset" ASSET,
