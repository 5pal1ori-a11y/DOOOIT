    RECORD TYPE CD_QuizRecord (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_correct" INT64,
        "CD_date" TIMESTAMP,
        "CD_entityName" STRING,
        "CD_step" STRING,
        "CD_step_ckAsset" ASSET,
        "CD_subject" STRING,
        "CD_subject_ckAsset" ASSET,
        "CD_total" INT64,
        "CD_unit" STRING,
        "CD_unit_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_StudyContent (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_createdAt" TIMESTAMP,
        "CD_data" BYTES,
        "CD_data_ckAsset" ASSET,
        "CD_entityName" STRING,
        "CD_key" STRING,
        "CD_key_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_StudySession (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_categoryName" STRING,
        "CD_categoryName_ckAsset" ASSET,
        "CD_entityName" STRING,
        "CD_id" STRING,
        "CD_planKey" STRING,
        "CD_planKey_ckAsset" ASSET,
        "CD_seconds" INT64,
        "CD_start" TIMESTAMP,
        "CD_title" STRING,
        "CD_title_ckAsset" ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WeakConcept (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_attemptCount" INT64,
        "CD_causesData" BYTES,
        "CD_causesData_ckAsset" ASSET,
        "CD_concept" STRING,
        "CD_concept_ckAsset" ASSET,
        "CD_createdAt" TIMESTAMP,
        "CD_entityName" STRING,
        "CD_gradeLabel" STRING,
        "CD_gradeLabel_ckAsset" ASSET,
        "CD_key" STRING,
        "CD_key_ckAsset" ASSET,
        "CD_lastAnswer" STRING,
        "CD_lastAnswer_ckAsset" ASSET,
        "CD_lastCorrectAnswer" STRING,
        "CD_lastCorrectAnswer_ckAsset" ASSET,
        "CD_lastStudiedAt" TIMESTAMP,
        "CD_lastWrongAt" TIMESTAMP,
        "CD_mastery" DOUBLE,
        "CD_problemType" STRING,
        "CD_problemType_ckAsset" ASSET,
        "CD_recordsData" BYTES,
        "CD_recordsData_ckAsset" ASSET,
        "CD_subject" STRING,
        "CD_subject_ckAsset" ASSET,
        "CD_unit" STRING,
        "CD_unit_ckAsset" ASSET,
        "CD_wrongCount" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
