    RECORD TYPE CD_Word (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        "CD_correctCount" INT64,
        "CD_createdAt" TIMESTAMP,
        "CD_deck" STRING,
        "CD_deck_ckAsset" ASSET,
        "CD_entityName" STRING,
        "CD_id" STRING,
        "CD_isStarred" INT64,
        "CD_learnedAt" TIMESTAMP,
        "CD_meaning" STRING,
        "CD_meaning_ckAsset" ASSET,
        "CD_nextReviewAt" TIMESTAMP,
        "CD_reviewStage" INT64,
        "CD_term" STRING,
        "CD_term_ckAsset" ASSET,
        "CD_wrongCount" INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
