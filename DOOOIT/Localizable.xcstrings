        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の勉強時間が少なめ。来週1〜2回増やそう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@学习时间较少，下周多安排一两次吧。"
          }
