    "플랜 완료율이 %lld%%예요. 계획을 80%% 정도만 채우고 작게 쪼개 보세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan completion is %lld%%. Plan about 80%% and break tasks down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラン達成率は%lld%%。予定は80%%程度にして小さく分けよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划完成率为%lld%%。计划排到80%%左右，再拆成小块试试。"
          }
        }
      }
    },
    "플랜 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Plan"
          }
        },
