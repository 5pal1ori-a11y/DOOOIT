    "%@님, 남은 하루도 힘내세요!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, finish the day strong!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さん、残りの1日もがんばって！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，今天剩下的时间也加油！"
          }
        }
      }
    },
    "%@님, 오늘도 힘내보아요!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, let's do great today!"
          }
