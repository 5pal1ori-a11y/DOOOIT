    "%@ '%@' 정답률이 %lld%%예요. AI 학습에서 개념부터 다시 보고 문제를 풀어봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ '%@' is at %lld%%. Review the concept in AI Study and practice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@「%@」の正答率は%lld%%。AI学習で概念から見直して解いてみよう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@“%@”正确率为%lld%%。在 AI 学习中先复习概念再做题吧。"
          }
        }
      }
    },
