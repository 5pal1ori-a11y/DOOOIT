          }
        }
      }
    },
    "모티 ZERO는 한국어로만 답해요. 모티 1·2를 받으면 이 언어로 대화해요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI ZERO replies in Korean only. Download MOTI 1 or 2 to chat in English."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI ZEROは韓国語でのみ答えます。MOTI 1・2を入れると日本語で会話できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI ZERO 只用韩语回答。下载 MOTI 1 或 2 即可用中文对话。"
          }
        }
      }
    },
    "모티 랭킹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI Ranking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTIランキング"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI 排行"
          }
        }
      }
    },
    "모티 랭킹은 Apple Game Center로 순위를 모아요. 로그인하면 다른 학생들과 공부 시간을 겨룰 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI Ranking uses Apple Game Center. Sign in to compete with other students on study time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTIランキングはApple Game Centerで集計します。サインインすると他の学生と学習時間を競えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI 排行通过 Apple Game Center 统计。登录后可与其他同学比拼学习时长。"
          }
        }
      }
    },
    "모티 풀이 엔진이 직접 푼 단계예요. 문제 글이 정확해야 풀이도 정확해요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps solved by MOTI's engine. Accurate text gives an accurate solution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTIの解答エンジンが解いた手順です。問題文が正確なら解き方も正確です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 MOTI 解题引擎的步骤。题目文字准确，解答才准确。"
          }
        }
      }
    },
    "모티가 확실하게 채점할 수 없었어요. 직접 골라 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI couldn't grade this for sure. Please choose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTIが確実に採点できませんでした。選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI 无法确定批改结果，请自行选择。"
          }
        }
      }
    },
