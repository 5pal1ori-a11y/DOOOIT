          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加计划"
          }
        }
      }
    },
    "플랜, 단어, 오답노트, 메모, 공부 기록이 모두 삭제되며 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All plans, words, notes, memos and records will be deleted. This can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラン・単語・ノート・メモ・学習記録がすべて削除され、元に戻せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划、单词、错题本、备忘和学习记录将全部删除，且无法恢复。"
          }
        }
      }
    },
    "플랜을 %lld%% 지켰어요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept %lld%% of plans"
          }
        },
