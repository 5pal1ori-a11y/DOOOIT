            "value": "Type x² as ^2 and roots as √( ) — they'll display nicely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "x²は^2、ルートは√( )と書いてもきれいに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "x² 可写成 ^2，根号写成 √( )，会自动美化显示。"
          }
        }
      }
    },
