            "state": "translated",
            "value": "%@さん、今日もがんばろう！"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，今天也加油！"
          }
        }
      }
    },
    "%@님, 조용한 새벽이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, it's a quiet late night."
