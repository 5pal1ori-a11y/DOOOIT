{
  "sourceLanguage": "ko",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI uses the camera to scan word lists and problems and read the text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語帳や問題を撮影して文字を読み取るためにカメラを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영어 단어장과 수학 문제를 촬영해 자동으로 글자를 읽기 위해 카메라를 사용해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI 使用相机拍摄单词表和题目并自动识别文字。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI uses the microphone for pronunciation practice and voice questions to MOTI AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発音練習とMOTI AIへの音声質問にマイクを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영어 발음 연습과 모티 AI에 말로 질문할 때 마이크를 사용해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI 在发音练习和向 MOTI AI 语音提问时使用麦克风。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI needs photo access to import word lists and problem photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語帳や問題の写真を読み込むために写真へのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범의 단어장, 문제 사진을 불러오기 위해 사진 접근 권한이 필요해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MOTI 需要访问照片以导入单词表和题目照片。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns spoken words and questions into text, on device when possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した単語や質問を文字に変換します。できるだけ端末内で処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따라 말한 단어와 말로 한 질문을 글자로 바꿔요. 되도록 기기 안에서 처리해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你说的单词和问题转为文字，尽量在设备上处理。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
